# Google AI Studio key — Live API butuh key Google langsung (bukan 9router)
GEMINI_API_KEY=

# path ke repo waai (persona.js + store.json)
WAAI_ROOT=../waai

# password / "kode masuk" buat ell
LIVE_PASSWORD=ganti-ini

# suara Gemini Live (prebuilt): Umbriel, Puck, Charon, Kore, Fenrir, Zephyr, Orus, Aoede, …
VOICE=Umbriel

# deploy: 0.0.0.0 biar bisa diakses dari luar; di belakang Cloudflare tunnel/nginx
HOST=0.0.0.0
PORT=8787
